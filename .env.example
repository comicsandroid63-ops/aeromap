# Supabase Configuration for File Storage (REQUIRED for 100% cloud-based)
# Get these from https://supabase.com → Project Settings → API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_anon_key_here
SUPABASE_SERVICE_KEY=your_service_role_key_here
SUPABASE_BUCKET=raster-files

# Turso Configuration for Database
TURSO_URL=libsql://your-db.turso.io
TURSO_AUTH_TOKEN=your_turso_token

# Vercel Environment
VERCEL_ENV=production

# GDAL Path (Windows)
GDAL_PATH=C:\Program Files\GDAL
