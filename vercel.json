{
  "version": 2,
  "builds": [
    {
      "src": "api/**/*.js",
      "use": "@vercel/node"
    },
    {
      "src": "public/**/*",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "headers": {
        "X-Content-Type-Options": "nosniff",
        "X-Frame-Options": "SAMEORIGIN",
        "X-XSS-Protection": "1; mode=block",
        "Referrer-Policy": "strict-origin-when-cross-origin"
      },
      "continue": true
    },
    {
      "src": "/api/auth/(.*)",
      "dest": "/api/auth.js?action=$1"
    },
    {
      "src": "/api/auth",
      "dest": "/api/auth.js"
    },
    {
      "src": "/api/admin/dashboard",
      "dest": "/api/dashboard.js"
    },
    {
      "src": "/api/dashboard",
      "dest": "/api/dashboard.js"
    },
    {
      "src": "/api/upload-visualization",
      "dest": "/api/upload.js?action=visualization"
    },
    {
      "src": "/api/import-tiff",
      "dest": "/api/upload.js?action=import-tiff"
    },
    {
      "src": "/api/zip-to-rgb",
      "dest": "/api/upload.js?action=zip-to-rgb"
    },
    {
      "src": "/api/render-preview/(.*)",
      "dest": "/api/dzi-generator.js"
    },
    {
      "src": "/api/dzi/(.*)",
      "dest": "/api/dzi-generator.js"
    },
    {
      "src": "/api/([^/]+)(?:/(.*))?",
      "dest": "/api/$1.js"
    },
    {
      "src": "/(.*)",
      "dest": "/public/$1"
    }
  ]
}
