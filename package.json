{
  "name": "aeromap-gis-editor",
  "version": "1.0.0",
  "description": "Professional GIS Map Editor with Shapefile Support",
  "keywords": [
    "gis",
    "map",
    "geospatial",
    "shapefile",
    "leaflet",
    "editor"
  ],
  "private": true,
  "engines": {
    "node": ">=20.0.0"
  },
  "author": "Your Name",
  "license": "MIT",
  "scripts": {
    "start": "node server.js",
    "build:css": "tailwindcss -i ./src/input.css -o ./public/output.css --minify",
    "watch:css": "tailwindcss -i ./src/input.css -o ./public/output.css --watch",
    "build": "npm run build:css",
    "cleanup": "node scripts/cleanup.js",
    "cleanup:dry": "node scripts/cleanup.js --dry-run",
    "clean-duplicates": "node scripts/clean-duplicates.js",
    "sync-cloud": "node scripts/sync-cloud.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1117.0",
    "@aws-sdk/s3-request-presigner": "^3.1156.0",
    "@libsql/client": "^0.17.4",
    "@vercel/blob": "^2.8.2",
    "cors": "^2.8.5",
    "dotenv": "^17.4.2",
    "express": "^4.19.2",
    "georaster": "^1.6.0",
    "georaster-layer-for-leaflet": "^4.1.2",
    "maplibre-gl": "^4.7.1",
    "mgrs": "^2.2.0",
    "multer": "^1.4.5-lts.1",
    "sharp": "^0.33.2",
    "tus-js-client": "^4.3.1",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "@tailwindcss/container-queries": "^0.1.1",
    "@tailwindcss/forms": "^0.5.11",
    "tailwindcss": "3.4.17"
  }
}
